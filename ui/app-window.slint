import { Theme } from "theme.slint";
// Static design preview. Sample results do not perform searches or launch apps.
import { ScrollView, Palette } from "std-widgets.slint";
export { SettingsWindow, LauncherTray } from "settings-window.slint";

export component StartupErrorWindow inherits Window {
    title: "Flow · 启动失败";
    width: 520px; height: 190px;
    background: Theme.surface;
    in property <string> message;
    Text {
        x: 24px; y: 24px; width: 472px; height: 142px;
        text: root.message; color: Theme.text; font-size: 14px;
        wrap: word-wrap;
    }
}
component KeyCap inherits Rectangle {
    in property <string> label;
    in property <bool> enter-icon: false;
    width: 26px; height: 22px;
    background: Theme.key-background; border-radius: 5px;
    border-width: 1px; border-color: Theme.border;
    Text {
        visible: !root.enter-icon;
        text: root.label; color: Theme.secondary; font-size: 11px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.enter-icon : Image {
        x: (parent.width - 13px) / 2; y: (parent.height - 13px) / 2;
        width: 13px; height: 13px; source: @image-url("icons/enter.svg");
    }
}
component Category inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    height: 27px; width: 56px; border-radius: 6px;
    background: selected ? Theme.selected : transparent;
    Text {
        text: root.label; color: root.selected ? Theme.accent : Theme.secondary;
        font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
    }
}
component ResultRow inherits Rectangle {
    callback choose();
    in property <image> icon;
    in property <color> icon-background;
    in property <string> title;
    in property <string> subtitle;
    in property <string> kind;
    in property <string> shortcut;
    in property <bool> selected: false;
    width: 680px; height: 54px; border-radius: 9px;
    background: selected ? Theme.selected : (hover.has-hover ? Theme.hover : transparent);
    border-width: selected ? 1px : 0px; border-color: Theme.selected-border;
    Rectangle {
        x: 12px; y: 9px; width: 36px; height: 36px;
        border-radius: 9px; background: root.icon-background;
        Image { x: 6px; y: 6px; width: 24px; height: 24px; source: root.icon; }
    }
    Text {
        x: 62px; y: 8px; width: 430px; height: 20px;
        text: root.title; color: Theme.text; font-size: 14px; font-weight: 600;
        overflow: elide; vertical-alignment: center;
    }
    Text {
        x: 62px; y: 29px; width: 480px; height: 16px;
        text: root.subtitle; color: root.selected ? Theme.secondary : Theme.secondary;
        font-size: 11px; overflow: elide; vertical-alignment: center;
    }
    Text {
        x: 550px; width: 64px; height: parent.height;
        text: root.kind; color: Theme.muted; font-size: 11px;
        horizontal-alignment: right; vertical-alignment: center;
    }
    if root.selected : KeyCap { x: 648px; y: 16px; enter-icon: true; }
    if !root.selected : Text {
        x: 624px; width: 50px; height: parent.height;
        text: root.shortcut; color: Theme.muted; font-size: 11px;
        horizontal-alignment: right; vertical-alignment: center;
    }
    hover := TouchArea { clicked => { root.choose(); } }
}
export component AppWindow inherits Window {
    title: "Flow · Launcher Preview";
    width: 760px; height: 386px;
    no-frame: true; background: transparent;
    default-font-family: root.is-macos ? "Helvetica Neue" : "Segoe UI";
    in property <bool> is-macos: false;
    in-out property <string> query-text: "";
    in-out property <length> results-scroll-y <=> results-scroll.content-y;
    in-out property <int> selected-index: 0;
    in property <int> result-count: 6;
    in property <string> shortcut-text: "Alt + Space";
    callback close-requested();
    callback quit-requested();
    public function focus-search() { input.focus(); }
    public function move-selection(delta: int) {
        root.selected-index = max(0, min(root.result-count - 1, root.selected-index + delta));
        input.focus();
    }
    changed selected-index => {
        let row-top = root.selected-index * 54px;
        let visible-top = -root.results-scroll-y;
        if row-top < visible-top {
            root.results-scroll-y = -row-top;
        } else if row-top + 54px > visible-top + 162px {
            root.results-scroll-y = -(row-top + 54px - 162px);
        }
    }
    panel := Rectangle {
        x: 20px; y: 16px; width: 720px; height: 346px;
        border-radius: 16px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 18px; drop-shadow-offset-y: 6px;
        drop-shadow-color: #273b5a20;
        Image { x: 25px; y: 29px; width: 26px; height: 26px; source: @image-url("icons/search.svg"); }
        input := TextInput {
            x: 68px; y: 23px; width: 556px; height: 40px;
            text <=> root.query-text; color: Theme.text; font-size: 21px;
            vertical-alignment: center; single-line: true;
            selection-background-color: #c8ddff;
            selection-foreground-color: Theme.text;
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-requested(); return accept; }
                if event.text == Key.UpArrow { root.move-selection(-1); return accept; }
                if event.text == Key.DownArrow { root.move-selection(1); return accept; }
                return reject;
            }
        }
        if root.query-text == "" : Text {
            x: 68px; y: 23px; width: 556px; height: 40px;
            text: "搜索应用、文件或命令…"; color: Theme.muted; font-size: 21px;
            vertical-alignment: center;
        }
        Rectangle {
            x: 648px; y: 28px; width: 46px; height: 28px;
            border-radius: 6px; background: dismiss.has-hover ? Theme.hover : Theme.key-background;
            border-width: 1px; border-color: Theme.border;
            Text { text: "esc"; color: Theme.secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
            dismiss := TouchArea { clicked => { root.close-requested(); } }
        }
        Rectangle { x: 1px; y: 84px; width: 718px; height: 1px; background: Theme.divider; }
        HorizontalLayout {
            x: 20px; y: 96px; width: 302px; height: 27px; spacing: 5px;
            Category { label: "全部"; selected: true; }
            Category { label: "应用"; }
            Category { label: "文件"; }
            Category { label: "网页"; }
            Category { label: "命令"; }
        }
        Text {
            x: 590px; y: 96px; width: 103px; height: 27px;
            text: "推荐 · 6 项"; color: Theme.muted; font-size: 11px;
            horizontal-alignment: right; vertical-alignment: center;
        }
        results-scroll := ScrollView {
            x: 12px; y: 134px; width: 696px; height: 162px;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: as-needed;
            content-height: result-layout.height;
            content-width: self.visible-width;
            result-layout := VerticalLayout {
            width: 680px; height: self.preferred-height; spacing: 0px;
            ResultRow {
                icon: @image-url("icons/code.svg"); icon-background: #e7f4ff;
                title: "Visual Studio Code"; subtitle: "代码编辑器 · 开始下一段创作";
                kind: "应用"; selected: root.selected-index == 0;
                choose => { root.selected-index = 0; input.focus(); }
            }
            ResultRow {
                icon: @image-url("icons/terminal.svg"); icon-background: #eef1f6;
                title: root.is-macos ? "Terminal" : "Windows Terminal";
                subtitle: "终端 · 在命令行中工作"; kind: "应用";
                shortcut: root.is-macos ? "⌘ 2" : "Alt 2";
                selected: root.selected-index == 1;
                choose => { root.selected-index = 1; input.focus(); }
            }
            ResultRow {
                icon: @image-url("icons/folder.svg"); icon-background: #fff4dc;
                title: "Documents"; subtitle: "文档 · 常用文件与工作资料"; kind: "文件夹";
                shortcut: root.is-macos ? "⌘ 3" : "Alt 3";
                selected: root.selected-index == 2;
                choose => { root.selected-index = 2; input.focus(); }
            }
            ResultRow {
                icon: @image-url("icons/settings.svg"); icon-background: #edf0f7;
                title: root.is-macos ? "系统设置" : "Windows 设置";
                subtitle: "系统 · 个性化、网络与设备"; kind: "命令";
                shortcut: root.is-macos ? "⌘ 4" : "Alt 4";
                selected: root.selected-index == 3;
                choose => { root.selected-index = 3; input.focus(); }
            }
            ResultRow {
                icon: @image-url("icons/globe.svg"); icon-background: #e9f2fd;
                title: "GitHub"; subtitle: "github.com · 探索你的下一个项目"; kind: "网页";
                shortcut: root.is-macos ? "⌘ 5" : "Alt 5";
                selected: root.selected-index == 4;
                choose => { root.selected-index = 4; input.focus(); }
            }
            ResultRow {
                icon: @image-url("icons/calculator.svg"); icon-background: #f1ecfb;
                title: "计算器"; subtitle: "快速计算 · 输入表达式即可开始"; kind: "工具";
                shortcut: root.is-macos ? "⌘ 6" : "Alt 6";
                selected: root.selected-index == 5;
                choose => { root.selected-index = 5; input.focus(); }
            }
            }
        }
        Rectangle { x: 1px; y: 308px; width: 718px; height: 1px; background: Theme.divider; }
        Image { x: 22px; y: 321px; width: 16px; height: 16px; source: @image-url("icons/flow.svg"); }
        Text { x: 45px; y: 317px; width: 42px; height: 25px; text: "Flow"; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        Text { x: 88px; y: 317px; width: 230px; height: 25px; text: root.shortcut-text + " · 唤起 / 隐藏"; color: Theme.secondary; font-size: 11px; vertical-alignment: center; }
        KeyCap { x: 397px; y: 319px; label: "↑"; }
        KeyCap { x: 427px; y: 319px; label: "↓"; }
        Text { x: 460px; y: 317px; width: 38px; height: 25px; text: "选择"; color: Theme.secondary; font-size: 11px; vertical-alignment: center; }
        KeyCap { x: 509px; y: 319px; enter-icon: true; }
        Text { x: 542px; y: 317px; width: 38px; height: 25px; text: "打开"; color: Theme.secondary; font-size: 11px; vertical-alignment: center; }
        KeyCap { x: 591px; y: 319px; width: 47px; label: root.is-macos ? "⌘ K" : "Ctrl K"; }
        Text { x: 646px; y: 317px; width: 50px; height: 25px; text: "操作"; color: Theme.secondary; font-size: 11px; vertical-alignment: center; }
    }
    init => { Palette.color-scheme = ColorScheme.light; input.focus(); }
}
