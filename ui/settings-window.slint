import { Theme } from "theme.slint";
import { LineEdit, Palette, ScrollView } from "std-widgets.slint";

export struct SearchTagEntry { keyword: string, name: string, url-template: string }

component Action inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> selected: false;
    in property <bool> destructive: false;
    in property <bool> navigation: false;
    in property <image> icon;
    callback clicked();
    width: 120px; height: 38px;
    border-radius: 8px;
    background: primary ? (touch.pressed ? #244fa2 : touch.has-hover ? #2c60be : Theme.accent)
        : selected ? Theme.selected : touch.has-hover ? Theme.hover : quiet ? transparent : Theme.surface;
    border-width: quiet || primary ? 0px : 1px;
    border-color: Theme.border;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    if root.navigation : Image {
        x: 16px; y: (parent.height - 18px) / 2; width: 18px; height: 18px;
        source: root.icon; colorize: root.selected ? Theme.accent : Theme.secondary;
    }
    Text {
        x: root.navigation ? 46px : 0px; width: parent.width - self.x; height: parent.height;
        text: root.text; font-size: 13px; font-weight: root.primary || root.selected ? 600 : 400;
        horizontal-alignment: root.navigation ? left : center; vertical-alignment: center;
        color: root.primary ? #ffffff : root.destructive ? Theme.error : root.selected ? Theme.accent : Theme.text;
    }
    touch := TouchArea { clicked => { keys.focus(); root.clicked(); } }
    keys := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; }
            return reject;
        }
    }
    if keys.has-focus : Rectangle {
        x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px;
        background: transparent; border-radius: 10px; border-width: 2px; border-color: Theme.selected-border;
    }
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 14px;
    border-width: 1px; border-color: #e3e9f2;
    drop-shadow-blur: 8px; drop-shadow-offset-y: 2px; drop-shadow-color: #24416a06;
}

component TagRow inherits Rectangle {
    in property <SearchTagEntry> tag;
    callback edit(); callback remove();
    height: 56px;
    background: transparent;
    Rectangle {
        x: 12px; y: 12px; width: 42px; height: 32px; border-radius: 7px; background: Theme.selected;
        Text { text: root.tag.keyword; color: Theme.accent; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
    Text { x: 68px; y: 8px; width: parent.width - 230px; height: 20px; text: root.tag.name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
    Text { x: 68px; y: 30px; width: parent.width - 230px; height: 16px; text: root.tag.url-template; color: Theme.muted; font-size: 11px; overflow: elide; }
    Action { x: parent.width - 148px; y: 10px; width: 66px; height: 36px; quiet: true; text: "编辑"; clicked => { root.edit(); } }
    Action { x: parent.width - 78px; y: 10px; width: 66px; height: 36px; quiet: true; destructive: true; text: "删除"; clicked => { root.remove(); } }
    Rectangle { x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px; background: Theme.divider; }
}

export component SettingsWindow inherits Window {
    title: "Flow · 设置";
    preferred-width: 920px; preferred-height: 660px;
    min-width: 840px; min-height: 660px;
    background: #f7f9fc;
    in property <bool> is-macos: false;
    default-font-family: root.is-macos ? "Helvetica Neue" : "Segoe UI";
    in property <string> app-version;
    in property <string> platform-text;
    in property <string> config-path;
    in-out property <string> current-hotkey;
    in-out property <string> edited-hotkey;
    in-out property <string> status-message: "保存后立即生效，下次启动自动恢复。";
    in-out property <bool> status-error: false;
    callback save-shortcut(string);
    in-out property <bool> show-search-tags: false;
    in property <[SearchTagEntry]> search-tags;
    in-out property <int> editing-tag-index: -1;
    in-out property <string> tag-keyword;
    in-out property <string> tag-name;
    in-out property <string> tag-template;
    in-out property <string> tag-status: "使用 {query} 代表搜索内容，例如 https://www.baidu.com/s?wd={query}";
    in-out property <bool> tag-error: false;
    callback save-tag(int, string, string, string);
    callback edit-tag(int);
    callback delete-tag(int);
    public function reset-tag-editor() {
        root.editing-tag-index = -1; root.tag-keyword = ""; root.tag-name = ""; root.tag-template = "";
    }

    Rectangle {
        x: 0px; y: 0px; width: 200px; height: parent.height; background: #ffffff;
        Image { x: 24px; y: 28px; width: 32px; height: 32px; source: @image-url("icons/tray.svg"); }
        Text { x: 68px; y: 29px; height: 30px; text: "Flow"; font-size: 21px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
        Text { x: 24px; y: 90px; text: "偏好设置"; font-size: 11px; color: Theme.muted; }
        Action { x: 16px; y: 120px; width: 168px; height: 44px; navigation: true; quiet: true; selected: !root.show-search-tags; icon: @image-url("icons/settings.svg"); text: "常规设置"; clicked => { root.show-search-tags = false; } }
        Action { x: 16px; y: 174px; width: 168px; height: 44px; navigation: true; quiet: true; selected: root.show-search-tags; icon: @image-url("icons/globe.svg"); text: "搜索标签"; clicked => { root.show-search-tags = true; } }
        Rectangle { x: 24px; y: parent.height - 82px; width: 152px; height: 1px; background: Theme.divider; }
        Text { x: 24px; y: parent.height - 62px; text: "Flow Launcher  ·  " + root.app-version; font-size: 11px; color: Theme.muted; }
        Rectangle { x: 24px; y: parent.height - 29px; width: 6px; height: 6px; border-radius: 3px; background: Theme.success; }
        Text { x: 38px; y: parent.height - 34px; text: "后台运行中"; font-size: 11px; color: Theme.secondary; }
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.divider; }
    }

    content := Rectangle {
        x: 200px; y: 0px; width: parent.width - 200px; height: parent.height; background: transparent;
        Text { x: 32px; y: 30px; text: root.show-search-tags ? "搜索标签" : "常规设置"; color: Theme.text; font-size: 26px; font-weight: 700; }
        Text { x: 32px; y: 76px; text: root.show-search-tags ? "为常用网站设置简短标签，搜索时一步直达。" : "管理应用信息与日常使用习惯。"; color: Theme.secondary; font-size: 13px; }

        if !root.show-search-tags : Rectangle {
            width: parent.width; height: parent.height; background: transparent;
            Card {
                x: 32px; y: 120px; width: parent.width - 64px; height: 174px;
                Image { x: 24px; y: 24px; width: 42px; height: 42px; source: @image-url("icons/tray.svg"); }
                Text { x: 82px; y: 23px; text: "Flow Launcher"; font-size: 18px; font-weight: 600; color: Theme.text; }
                Text { x: 82px; y: 51px; text: "桌面启动器"; font-size: 12px; color: Theme.muted; }
                Rectangle { x: parent.width - 104px; y: 29px; width: 80px; height: 26px; border-radius: 6px; background: Theme.canvas;
                    Text { text: "v" + root.app-version; font-size: 11px; color: Theme.secondary; horizontal-alignment: center; vertical-alignment: center; } }
                Rectangle { x: 24px; y: 88px; width: parent.width - 48px; height: 1px; background: Theme.divider; }
                Text { x: 24px; y: 107px; text: "运行平台"; color: Theme.muted; font-size: 11px; }
                Text { x: 24px; y: 131px; text: root.platform-text; color: Theme.text; font-size: 13px; }
                Text { x: parent.width / 2; y: 107px; text: "搜索窗口"; color: Theme.muted; font-size: 11px; }
                Text { x: parent.width / 2; y: 131px; text: "切换到其他窗口时自动隐藏"; color: Theme.text; font-size: 13px; }
            }
            Card {
                x: 32px; y: 318px; width: parent.width - 64px; height: 202px;
                Text { x: 24px; y: 22px; text: "启动快捷键"; color: Theme.text; font-size: 16px; font-weight: 600; }
                Text { x: 24px; y: 51px; text: "在任意应用中唤起或隐藏搜索框。"; color: Theme.secondary; font-size: 12px; }
                Rectangle { x: parent.width - 202px; y: 24px; width: 178px; height: 28px; border-radius: 6px; background: Theme.selected;
                    Text { text: root.current-hotkey; color: Theme.accent; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } }
                Text { x: 24px; y: 86px; text: "快捷键组合"; color: Theme.secondary; font-size: 12px; }
                LineEdit { x: 24px; y: 110px; width: parent.width - 224px; height: 40px; text <=> root.edited-hotkey; placeholder-text: "例如 Ctrl+Alt+Space"; accepted(value) => { root.save-shortcut(value); } }
                Action { x: parent.width - 184px; y: 110px; width: 160px; height: 40px; text: "保存快捷键"; primary: true; clicked => { root.save-shortcut(root.edited-hotkey); } }
                Text { x: 24px; y: 169px; width: parent.width - 48px; height: 20px; text: root.status-message; color: root.status-error ? Theme.error : Theme.success; font-size: 12px; overflow: elide; }
            }
            Text { x: 56px; y: 548px; text: "配置文件"; color: Theme.muted; font-size: 11px; }
            Text { x: 56px; y: 571px; width: parent.width - 112px; height: 38px; text: root.config-path; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
        }

        if root.show-search-tags : Rectangle {
            width: parent.width; height: parent.height; background: transparent;
            Card {
                x: 32px; y: 120px; width: parent.width - 64px; height: 174px;
                Text { x: 24px; y: 17px; text: "已添加的标签"; color: Theme.text; font-size: 14px; font-weight: 600; }
                Text { x: parent.width - 100px; y: 20px; width: 76px; text: root.search-tags.length + " 个标签"; color: Theme.muted; font-size: 11px; horizontal-alignment: right; }
                ScrollView {
                    x: 12px; y: 48px; width: parent.width - 24px; height: 120px;
                    horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: as-needed;
                    content-height: tags-layout.height; content-width: self.visible-width;
                    tags-layout := VerticalLayout {
                        width: parent.visible-width - 14px; height: self.preferred-height; spacing: 0px;
                        for tag[index] in root.search-tags : TagRow {
                            width: tags-layout.width; tag: tag;
                            edit => { root.edit-tag(index); }
                            remove => { root.delete-tag(index); }
                        }
                    }
                }
                if root.search-tags.length == 0 : Text { x: 24px; y: 64px; width: parent.width - 48px; height: 80px; text: "还没有搜索标签，在下方添加第一个。"; color: Theme.muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            }
            Card {
                x: 32px; y: 318px; width: parent.width - 64px; height: 286px;
                Text { x: 24px; y: 20px; text: root.editing-tag-index == -1 ? "添加新标签" : "编辑搜索标签"; color: Theme.text; font-size: 16px; font-weight: 600; }
                Text { x: 24px; y: 61px; text: "标签"; color: Theme.secondary; font-size: 12px; }
                Text { x: 196px; y: 61px; text: "网站名称"; color: Theme.secondary; font-size: 12px; }
                LineEdit { x: 24px; y: 84px; width: 152px; height: 38px; text <=> root.tag-keyword; placeholder-text: "例如 b"; }
                LineEdit { x: 196px; y: 84px; width: parent.width - 220px; height: 38px; text <=> root.tag-name; placeholder-text: "例如 百度"; }
                Text { x: 24px; y: 141px; text: "搜索网址模板"; color: Theme.secondary; font-size: 12px; }
                LineEdit { x: 24px; y: 164px; width: parent.width - 48px; height: 38px; text <=> root.tag-template; placeholder-text: "https://www.baidu.com/s?wd={query}"; }
                Text { x: 24px; y: 211px; text: "用 {query} 代替搜索内容，例如输入 b Rust。"; color: Theme.muted; font-size: 11px; }
                Action { x: parent.width - 284px; y: 238px; width: 96px; height: 36px; quiet: true; text: "清空"; clicked => { root.reset-tag-editor(); } }
                Action { x: parent.width - 172px; y: 238px; width: 148px; height: 36px; text: root.editing-tag-index == -1 ? "添加标签" : "保存修改"; primary: true; clicked => { root.save-tag(root.editing-tag-index, root.tag-keyword, root.tag-name, root.tag-template); } }
            }
            Text { x: 36px; y: 617px; width: parent.width - 72px; height: 32px; text: root.tag-status; color: root.tag-error ? Theme.error : Theme.secondary; font-size: 11px; wrap: word-wrap; }
        }
    }
    init => { Palette.color-scheme = ColorScheme.light; }
}

export component LauncherTray inherits SystemTrayIcon {
    icon: @image-url("icons/tray.svg"); visible: true; tooltip: "Flow Launcher"; title: "Flow";
    callback open-search(); callback open-settings(); callback quit-app();
    clicked => { root.open-search(); }
    Menu {
        MenuItem { title: "打开搜索框"; activated => { root.open-search(); } }
        MenuItem { title: "打开设置"; activated => { root.open-settings(); } }
        MenuSeparator { }
        MenuItem { title: "退出"; activated => { root.quit-app(); } }
    }
}
