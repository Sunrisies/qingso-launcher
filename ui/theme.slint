// Shared light palette for launcher, settings and startup dialogs.
export global Theme {
    out property <color> canvas: #f4f6fa;
    out property <color> surface: #ffffff;
    out property <color> text: #233047;
    out property <color> secondary: #617087;
    out property <color> muted: #76839a;
    out property <color> border: #dce3ed;
    out property <color> divider: #e8edf4;
    out property <color> accent: #356cce;
    out property <color> selected: #eaf2ff;
    out property <color> selected-border: #bfd3f3;
    out property <color> hover: #f2f5fa;
    out property <color> key-background: #f5f7fa;
    out property <color> success: #26724c;
    out property <color> error: #bf3e38;
}
